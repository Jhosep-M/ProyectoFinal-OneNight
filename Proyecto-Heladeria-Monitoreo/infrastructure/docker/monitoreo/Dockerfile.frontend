# =============================================================================
# ESPEJO — Monitoreo frontend para builds centralizados (Persona 4 / Task 6)
# Canónico: monitoreo/frontend/Dockerfile (mismo contenido).
# Uso recomendado (contexto = app):
#   docker build -f monitoreo/frontend/Dockerfile -t monitoreo-frontend:local ./monitoreo/frontend
# Multi-stage: build node:20-alpine (Vite -> dist) + runtime nginx:alpine (:80).
# Si se duplica contenido, mantener sincronizado con el canónico.
# =============================================================================
FROM node:20-alpine AS build
WORKDIR /app

ARG VITE_API_URL=http://localhost:4000/api/v1
ENV VITE_API_URL=${VITE_API_URL}

COPY package.json package-lock.json* ./
RUN npm ci --no-audit --no-fund
COPY . .
RUN npm run build

FROM nginx:alpine AS runtime
RUN printf 'server {\n\
  listen 80;\n\
  server_name _;\n\
  root /usr/share/nginx/html;\n\
  index index.html;\n\
  location / { try_files $uri $uri/ /index.html; }\n\
  location /assets/ { expires 1y; add_header Cache-Control "public, immutable"; }\n\
}\n' > /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
