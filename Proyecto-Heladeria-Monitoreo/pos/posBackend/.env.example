SUPABASE_URL=
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
DATABASE_URL=postgresql://postgres:password@db.lltmyookhktzycxlprlx.supabase.co:5432/postgres
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
MONITOREO_URL=https://monitoreo.example.com/api/v1/integrations/consumption
MONITOREO_API_KEY=dummy
ORGANIZACION_EXTERNA_ID=00000000-0000-0000-0000-000000000000
# Timeout por petición HTTP de integración (ms). Default 5000.
MONITOREO_TIMEOUT_MS=5000
# Endurecimiento Fase C. Timeouts de PostgreSQL (ms). Defaults 15000 / 30000.
DB_STATEMENT_TIMEOUT_MS=15000
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=30000
# Verificación del certificado TLS de la DB. Default true en producción, false en dev/test.
DB_SSL_REJECT_UNAUTHORIZED=true
# Timeout del servidor HTTP entrante (ms). Default 30000.
HTTP_TIMEOUT_MS=30000
# Integración Monitoreo -> POS (alertas). Debe coincidir con POS_ALERT_API_KEY del POS.
POS_ALERTS_URL=http://pos-backend:3000/api/v1/integrations/alerts
POS_ALERT_API_KEY=dummy-pos-alert-key
