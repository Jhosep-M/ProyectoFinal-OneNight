# =============================================================================
# .env.example — Proyecto Heladería + Monitoreo (Persona 4 / Task 6)
# =============================================================================
# Copiar a .env y completar valores reales. NUNCA subir .env a Git.
# Este archivo solo contiene PLACEHOLDERS, ningún secreto real.
# Sin DB local: ambos backends usan Supabase/PostgreSQL gestionado.
# =============================================================================

# --- Generales ----------------------------------------------------------------
NODE_ENV=development

# --- Puertos ------------------------------------------------------------------
# POS backend: 3000 | Monitoreo backend: 4000
# Frontends (solo dev con Vite): POS 5173, Monitoreo 5174.
# En Docker los frontends se sirven con nginx en puerto 80 interno.
PORT_POS=3000
PORT_MONITOREO=4000

# --- Supabase (compartido: mismo proyecto o uno por sistema) -------------------
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu-anon-key
# SOLO BACKEND — nunca exponer en frontend ni subir a Git.
SUPABASE_SERVICE_ROLE_KEY=solo-backend-nunca-frontend

# --- Bases de datos (Supabase/PostgreSQL, sin DB local en compose) -------------
DATABASE_URL=postgresql://postgres:TU_PASSWORD@db.tu-proyecto.supabase.co:5432/postgres
DATABASE_URL_MONITOREO=postgresql://postgres:TU_PASSWORD@db.tu-proyecto.supabase.co:5432/postgres

# --- CORS ----------------------------------------------------------------------
# Lista separada por comas, sin wildcard en producción.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# --- Rate limiting --------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# --- Integración POS -> Monitoreo ----------------------------------------------
# URL interna (nombre de servicio Docker / Service K8s). En producción usar HTTPS.
MONITOREO_URL=http://monitoreo-backend:4000/api/v1/integrations/consumption
MONITOREO_API_KEY=tu-monitoreo-api-key
MONITOREO_TIMEOUT_MS=5000
ORGANIZACION_EXTERNA_ID=00000000-0000-0000-0000-000000000000

# --- Integración Monitoreo -> POS (alertas) --------------------------------------
POS_ALERTS_URL=http://pos-backend:3000/api/v1/integrations/alerts
POS_ALERT_API_KEY=tu-pos-alert-api-key
